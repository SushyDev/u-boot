# THIS file sets the boot delay, not CONFIG_BOOTDELAY. The whole
# environment comes from here (CONFIG_ENV_IS_NOWHERE +
# CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE), so a bootdelay= line silently
# overrides the Kconfig value.
#
# 0, so bootcmd runs the menu immediately. This is NOT the menu's
# timeout -- bootmenu_delay is. bootdelay is main_loop()'s "hit any key
# to stop autoboot" countdown, which runs first, and a button press
# during it drops to the U-Boot prompt, which cannot be typed at with
# three buttons. The menu's own countdown is the interactive window and
# its appended "U-Boot console" entry is the deliberate way to the
# prompt.
bootdelay=0
bootretry=-1
# nulldev FIRST, then the buttons.
#
# NEVER use a bare "button-kbd". If it fails to probe the board has no
# stdin at all and will not boot -- recovery is fastboot. nulldev always
# binds and produces nothing, so it is a guaranteed-valid fallback, and
# CONSOLE_MUX polls every device in the list so the buttons still work.
#
# "serial" is deliberately absent: the debug UART is not connected and
# the floating RX reads as random characters, which selects a menu entry
# instantly.
stdin=nulldev,button-kbd
stdout=vidconsole
stderr=vidconsole

# Must be defined here -- this file is the entire environment, so
# nothing else sets them. All inside the 0x811d0000-0x88000000 bank and
# clear of every reserved-memory carveout in it.
kernel_addr_r=0x83000000
fdt_addr_r=0x86000000
pxefile_addr_r=0x87000000
scriptaddr=0x87000000
ramdisk_addr_r=0x87100000

# Manual scsi/ext4load/booti, bypassing bootflow/pxe, so bootargs are
# set explicitly here -- nothing parses extlinux.conf's APPEND line.
#
# console=tty0 + fbcon=map:0 is what puts the kernel boot log on the
# panel. fbcon alone does not make it a printk target; tty0 as a
# console= target is what does. Drop the pair and the log is
# serial-only.
#
# Bump sheng.b= on EVERY build. It is the only way to tell which image
# actually booted.
#
# NORMAL PATH: sysboot reads /boot/extlinux/extlinux.conf, which NixOS
# regenerates on every `nixos-rebuild boot/switch` with one LABEL per
# generation. It supplies LINUX/FDT/APPEND, so the per-generation
# init=/nix/store/... comes from there, not from here.
#
# SEQUENCED WITH ';', NOT '||'. sysboot returns 0 even when the boot
# fails -- pxe_process() only reports *parse* errors and
# handle_pxe_menu() is void -- so '||' would never fire. If control ever
# returns from bootnixos at all, something went wrong and the rescue
# path must run unconditionally.
bootlinux=run bootnixos; run bootrescue
bootnixos=scsi scan && part number scsi 0 userdata partnum && sysboot scsi 0:${partnum} any ${pxefile_addr_r} /boot/extlinux/extlinux.conf
#
# RESCUE PATH -- DO NOT DELETE. This is the pre-extlinux boot verbatim,
# and it is what makes the extlinux migration non-bricking: a missing,
# truncated or unparseable extlinux.conf falls through to here and boots
# exactly as this board always has.
#
# /boot/Image and the dtb are written by the image builder and are never
# touched by nixos-rebuild. There is deliberately no init= -- the kernel's
# built-in search finds /sbin/init, which the NixOS side keeps pointed at
# the current generation.
bootrescue=scsi scan && part number scsi 0 userdata partnum && ext4load scsi 0:${partnum} ${kernel_addr_r} /boot/Image && ext4load scsi 0:${partnum} ${fdt_addr_r} /boot/sm8550-xiaomi-sheng.dtb && setenv bootargs root=PARTLABEL=userdata rw rootwait console=ttyMSM0,115200n8 console=ttyGS0 console=tty0 fbcon=map:0 loglevel=4 sheng.b=421 log_buf_len=8M && booti ${kernel_addr_r} - ${fdt_addr_r}
#
# Per-generation menu entries, imported from a file NixOS regenerates
# alongside extlinux.conf.
#
# THE GENERATED FILE OWNS THE WHOLE MENU, index 0 included. It overwrites
# both static entries below: bootmenu_0 becomes the current generation
# named after itself, the older generations follow, and fastboot is
# re-emitted last so it sits at the bottom rather than above the list.
#
# That is still safe, because `env import` only overwrites what the file
# actually defines: if it is missing or fails to load, the static
# bootmenu_0 (boot) and bootmenu_1 (fastboot) below both survive. There is
# always a way to boot and always a way into fastboot.
#
# WHY IMPORT RATHER THAN ENUMERATE: hush cannot list a directory into
# variables and has no command substitution, so U-Boot cannot discover
# generations by itself. NixOS knows them, so NixOS writes them out.
#
# Loaded to ${pxefile_addr_r} deliberately: sysboot reuses that address
# later for the config file, and the two uses are strictly sequential, so
# this needs no address of its own (inventing one risks colliding with an
# lmb allocation, since board_late_init() assigns these from lmb).
loadgenmenu=scsi scan && part number scsi 0 userdata partnum && ext4load scsi 0:${partnum} ${pxefile_addr_r} /boot/sheng-bootmenu.env && env import -t ${pxefile_addr_r} ${filesize}
# FALLBACK ONLY -- not the entry you normally see.
#
# The rootfs owns the real menu: /boot/sheng-bootmenu.env defines
# bootmenu_0 too, naming it after the generation that will actually boot
# ("NixOS generation 7 (26.11...) [current]"). A title hardcoded here
# cannot know which generation it is selecting, so it stays deliberately
# generic and is overwritten on every normal boot.
#
# It must still exist, because entry 0 is what the countdown selects and
# what a held power key selects -- the highlight starts here. If the
# generated file is missing or unreadable, this is the only thing keeping
# the menu from having no bootable entry at all.
#
# Clearing pxe_label_override means extlinux.conf's own "DEFAULT" wins,
# i.e. the current generation. It must be cleared explicitly, because the
# env persists for the lifetime of this boot once a generated entry has
# been highlighted and then backed out of.
bootmenu_0=Boot NixOS=setenv pxe_label_override; run bootlinux
# Reboot into ABL's fastboot.
#
# Qualcomm does NOT use the Android BCB/misc handshake for this. Tried
# first (b372) and it does nothing: the bcb write succeeds, the board
# resets, and ABL boots normally straight past it.
#
# The real mechanism is a magic cookie in IMEM, which ABL reads after the
# reset. Address from the STOCK Android DTB (vendor_boot.img), which is
# authoritative for what ABL actually looks at:
#
#     qcom,msm-imem@146aa000 {
#             restart_reason@65c { reg = <0x65c 0x04>; };
#
# so 0x146aa000 + 0x65c = 0x146aa65c, and 0x77665500 is the
# boot-to-bootloader value. (Mainline's sm8550.dtsi describes a DIFFERENT
# imem at 0x14680000 -- do not use that one.)
#
# This is the one reset-shaped entry that is safe, and the "NEVER ADD A
# reset ENTRY" rule below still stands for plain resets. The difference
# is where it lands: a plain reset returns to this menu, so a stuck or
# bouncing button re-selects it forever and never reaches Linux. This
# lands in fastboot, which is a terminal, recoverable state -- and ABL
# clears the restart-reason cookie when it honours it, so the next boot
# is normal even if nobody touches anything.
#
# NOT U-Boot's own fastboot: this build has no USB gadget stack at all.
bootmenu_1=Reboot to fastboot (bootloader)=run rebootfastboot
rebootfastboot=mw.l 0x146aa65c 0x77665500 && reset
# NEVER ADD A "reset" ENTRY. A stuck or bouncing button selects it, the
# board reboots into the menu, and selects it again -- a loop that never
# reaches Linux and can only be broken over fastboot. Every other
# misfire is recoverable, because a power cycle returns to a menu that
# times out into entry 0.
#
# Finite on purpose: -1 waits forever, stranding the boot in an unusable
# menu if the buttons fail to bind. No Linux, no SSH, fastboot only.
bootmenu_delay=5
#
# loadgenmenu is run unguarded and its failure is ignored on purpose: on
# a freshly flashed image (or if /boot is damaged) there is no
# sheng-bootmenu.env, the && chain short-circuits, and the menu is just
# entries 0 and 1 -- which is the correct degraded behaviour, not an
# error worth stopping the boot for.
bootcmd=run loadgenmenu; bootmenu 5

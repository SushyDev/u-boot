bootdelay=1
bootretry=-1
stdin=serial
stdout=serial
stderr=serial

# sheng.env is the *entire* default environment (CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y,
# CONFIG_ENV_DEFAULT_ENV_TEXT_FILE points here) -- nothing from a generic
# board/qualcomm/default.env or arch env fragment is merged in. The extlinux
# bootmeth (boot/pxe_utils.c, get_relfile_envaddr()) needs kernel_addr_r and
# fdt_addr_r set in the environment to know where to load the kernel Image
# and FDT into RAM; without them it fails with -ENOENT per label and
# `bootflow scan -lb` silently finds nothing bootable -- no hang, no error
# printed loud enough to notice, it just falls through. That's almost
# certainly why earlier trap checkpoints "fired" (rebooted) after `bootflow
# scan -lb` even though no kernel was ever loaded: the scan completed
# (not hung) but never actually booted anything.
#
# CORRECTED: the previous addresses here (0xa8000000/0xb0000000) were
# picked from the *kernel* dtb's reserved-memory carveouts alone, which
# wrongly assumes DRAM is contiguous from 0x80000000 upward. It isn't.
# dts/upstream/src/arm64/qcom/sm8550-xiaomi-sheng.dts's memory@a0000000
# node (lines ~82-118) is annotated as pulled byte-for-byte from
# /proc/device-tree/memory@a0000000/reg on a live, working Debian boot --
# ground truth, not a guess -- and shows DRAM is fragmented into 7 banks:
#   0x80000000-0x80e00000   (14M)
#   0x811d0000-0x88000000   (~110M)   <- addresses below live here
#   0xd8140000-0xd8160000   (128K)
#   0xe7cb0000-0x100000000  (~392M)
#   0x880000000 and up      (>4G, high mem)
# 0xa8000000/0xb0000000 fell in the dead gap between bank 2 and bank 3 --
# no physical DRAM there at all, so the kernel/fdt load into that address
# would silently fail or corrupt. Bank 2 (0x811d0000-0x88000000) is
# clear of every reserved-memory carveout in both this file (xbl_ramdump_mem
# @81200000, xbl_dt_log_mem@81a00000, aop_image_mem@81c00000) and the
# kernel's own dtb (smem, aop-cmd-db, tz-stat-region, all ending by
# 0x82800000) from 0x82800000 to the 0x88000000 bank end -- ~86M of clean
# space for a ~42M kernel Image + 138K dtb.
kernel_addr_r=0x83000000
fdt_addr_r=0x86000000
pxefile_addr_r=0x87000000
scriptaddr=0x87000000
ramdisk_addr_r=0x87100000

# CONFIRMED (trap-bisection): scsi scan, userdata partition lookup, kernel
# Image load, and FDT load into the corrected addresses (kernel_addr_r/
# fdt_addr_r, see above) all succeed -- trap fired reliably here. Manual
# load path is solid; this is the real boot attempt, `booti` reads bootargs
# from the environment for the kernel cmdline (set explicitly here rather
# than relying on extlinux.conf's APPEND line, since we're bypassing
# bootflow/pxe entirely for this bring-up).
bootcmd=scsi scan && part number scsi 0 userdata partnum && ext4load scsi 0:${partnum} ${kernel_addr_r} /boot/Image && ext4load scsi 0:${partnum} ${fdt_addr_r} /boot/sm8550-xiaomi-sheng.dtb && setenv bootargs root=PARTLABEL=userdata rw console=ttyMSM0,115200n8 console=ttyGS0 fbcon=map:1 && booti ${kernel_addr_r} - ${fdt_addr_r}

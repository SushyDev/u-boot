# 30s window to interrupt autoboot and land at the U-Boot prompt.
#
# THIS is what actually sets the boot delay on this board, not
# CONFIG_BOOTDELAY. CONFIG_ENV_IS_NOWHERE=y + CONFIG_ENV_USE_DEFAULT_ENV_
# TEXT_FILE=y mean the whole environment comes from this file, so a
# bootdelay= line here overrides the Kconfig value silently. Setting
# CONFIG_BOOTDELAY=30 in sm8550_defconfig alone changed nothing -- the
# board still autobooted in 1 second.
# 0, so bootcmd (i.e. the boot menu) runs immediately.
#
# This is NOT the menu's timeout -- bootmenu_delay below is. bootdelay is
# main_loop()'s own "Hit any key to stop autoboot" countdown, which runs
# BEFORE bootcmd. It was 5, which was harmless while stdin was nulldev and
# nothing could ever press a key. Now that the buttons are real input, any
# press during that window aborts into the U-Boot prompt instead of the
# menu -- and there is no way to type at that prompt with three buttons.
# The menu's own 5s countdown is the interactive window, and its appended
# "U-Boot console" entry is the way to reach the prompt deliberately.
#
# THIS is what sets the boot delay on this board, not CONFIG_BOOTDELAY.
# CONFIG_ENV_IS_NOWHERE=y + CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y mean the
# environment comes entirely from this file, so a bootdelay= line here
# silently overrides the Kconfig value.
bootdelay=0
bootretry=-1
# stdin: nulldev FIRST, then the buttons.
#
# NEVER use a bare "button-kbd" here. If it fails to probe, the board has no
# stdin at all and does not boot -- measured, and it required a fastboot
# recovery. nulldev always binds (CONFIG_SYS_DEVICE_NULLDEV) and produces
# nothing, so it is a guaranteed-valid fallback; CONSOLE_MUX polls every
# device in the list, so the buttons still work with it present.
#
# Note "serial" is deliberately NOT in this list. This board's debug UART is
# not physically connected and the floating RX line reads as random
# characters -- that is what used to select entry 0 instantly and boot.
stdin=nulldev,button-kbd
stdout=vidconsole
stderr=vidconsole

# This file is the entire default environment (CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE),
# so kernel_addr_r/fdt_addr_r must be defined here for the kernel/FDT to load.
# They sit in the 0x811d0000-0x88000000 DRAM bank, verified against the live
# device's own /proc/device-tree/memory@a0000000/reg and clear of every
# reserved-memory carveout in that range.
kernel_addr_r=0x83000000
fdt_addr_r=0x86000000
pxefile_addr_r=0x87000000
scriptaddr=0x87000000
ramdisk_addr_r=0x87100000

# Manual scsi/ext4load/booti path -- bypasses bootflow/pxe entirely (see
# ../../README or nixos/rootfs/builder.nix for why), so bootargs must be
# set explicitly here; nothing parses extlinux.conf's APPEND line.
#
# console=tty0 + fbcon=map:0 dropped (TEMPORARY, for the cont_splash
# investigation): that pair is what routes kernel printk/systemd
# boot-status text onto the framebuffer -- fbcon being active doesn't
# make it a printk target by itself, tty0 as a console= target is what
# does. With it gone, printk stays on the serial consoles only, and
# whatever ABL left in the `cont_splash` region (or simplefb's own
# scanout of it) isn't immediately scrolled over with boot-log text.
# Re-add `console=tty0 fbcon=map:0` once that's no longer needed --
# without it there's no on-screen boot log at all, serial-only.
bootlinux=scsi scan && part number scsi 0 userdata partnum && ext4load scsi 0:${partnum} ${kernel_addr_r} /boot/Image && ext4load scsi 0:${partnum} ${fdt_addr_r} /boot/sm8550-xiaomi-sheng.dtb && setenv bootargs root=PARTLABEL=userdata rw rootwait console=ttyMSM0,115200n8 console=ttyGS0 console=tty0 fbcon=map:0 loglevel=4 sheng.b=328 log_buf_len=8M && booti ${kernel_addr_r} - ${fdt_addr_r}
# Entry 0 must stay the safe one: it is what the countdown selects, and what
# a held power key selects, since the highlight starts here.
bootmenu_0=Boot Linux (userdata)=run bootlinux
#
# THERE IS DELIBERATELY NO "reset" ENTRY.
#
# Now that the buttons are real input, a reset entry is the one genuine
# brick path in this menu: a stuck or bouncing button selects it, the board
# reboots straight back into the menu, and it selects it again -- a loop
# that never reaches Linux and so can only be broken over fastboot. Every
# other misfire is recoverable, because a power cycle returns to a menu that
# times out into entry 0. bootmenu appends its own "U-Boot console" entry
# after these; landing there is harmless (nothing to type with, but the next
# power cycle boots normally).
#
# Finite on purpose. -1 waits forever, which would strand the boot in an
# unusable menu if the buttons fail to bind -- no Linux, no SSH, and the
# only recovery is fastboot over USB.
bootmenu_delay=5
bootcmd=bootmenu 5

bootdelay=1
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
fastboot=fastboot -l $fastboot_addr_r usb 0

# Always probe for UFS storage, though it should be done by board code.
preboot=scsi scan

# Bring-up on a unit with no working display and no confirmed UART: land
# straight in fastboot mode unattended, never bootefi bootmgr. Unlike the
# usbacm console (drivers/usb/gadget/f_acm.c:acm_stdio_start() blocks in a
# `while (!acm_connected) schedule();` loop during console_init_r, i.e.
# *before* bootcmd even runs, if usbacm is in stdin/stdout/stderr -- that
# would silently swallow a real early hang and make it indistinguishable
# from "waiting for a host to connect"), fastboot's gadget enumerates on
# the bus immediately once the UDC probes, with no connection handshake to
# wait on, so `fastboot devices`/lsusb from the host is a clean yes/no
# signal for "did U-Boot reach USB init" with zero interaction needed.
bootcmd=run fastboot

# When entering the menu (either from button press or a manual "Boot" pick
# failing) remap bootcmd so it will re-open the menu and we won't get stuck
# at the console with no way to type.
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Pause is used so the output can be read on the display
bootmenu_0=Boot=bootefi bootmgr; pause
bootmenu_1=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_2=Enable fastboot mode=echo "Press any key to exit fastboot mode"; run fastboot
bootmenu_3=Drop to shell=setenv bootretry -1
bootmenu_4=Reset device=reset
bootmenu_5=Dump clocks=clk dump; pause
bootmenu_6=Dump environment=printenv; pause
bootmenu_7=Board info=bdinfo; pause
bootmenu_8=Dump bootargs=fdt addr $fdt_addr_r; fdt print /chosen bootargs; pause
bootmenu_9=Power off=poweroff

# Allow holding the volume down button while U-Boot loads to enter the menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd

# This file IS the environment (CONFIG_ENV_IS_NOWHERE +
# CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE), so bootdelay here overrides
# CONFIG_BOOTDELAY.
#
# 0 so bootcmd reaches the menu immediately. This is not the menu's
# timeout (bootmenu_delay is); it is main_loop()'s "hit any key to stop
# autoboot", and a button press during it drops to a prompt that three
# buttons cannot type at.
bootdelay=0
bootretry=-1
# nulldev FIRST. A bare "button-kbd" that fails to probe leaves the board
# with no stdin and it will not boot; recovery is fastboot. nulldev always
# binds, and CONSOLE_MUX polls the whole list so the buttons still work.
#
# No "serial": the debug UART is not connected and its floating RX reads
# as random characters, which selects a menu entry instantly.
stdin=nulldev,button-kbd
stdout=vidconsole
stderr=vidconsole

# Nothing else sets these. All inside the 0x811d0000-0x88000000 bank and
# clear of every reserved-memory carveout in it.
kernel_addr_r=0x83000000
fdt_addr_r=0x86000000
pxefile_addr_r=0x87000000
scriptaddr=0x87000000
ramdisk_addr_r=0x87100000

# NORMAL PATH: sysboot reads /boot/extlinux/extlinux.conf, which NixOS
# regenerates on every `nixos-rebuild boot/switch` with one LABEL per
# generation. It supplies LINUX/FDT/APPEND, so the per-generation
# init=/nix/store/... comes from there, not from here.
#
# ';' not '||': sysboot returns 0 even when the boot fails, because
# pxe_process() only reports parse errors and handle_pxe_menu() is void.
# If control returns from bootnixos at all, the rescue path must run.
bootlinux=run bootnixos; run bootrescue
bootnixos=scsi scan && part number scsi 0 userdata partnum && sysboot scsi 0:${partnum} any ${pxefile_addr_r} /boot/extlinux/extlinux.conf
#
# RESCUE PATH -- DO NOT DELETE. A missing or unparseable extlinux.conf
# falls through to here. /boot/Image and the dtb are written by the image
# builder and never touched by nixos-rebuild.
#
# No init=: the kernel's built-in search finds /sbin/init, which the
# NixOS side keeps pointed at the current generation.
#
# Bump sheng.b= on every build. It is the only way to tell which image
# booted on this path.
bootrescue=scsi scan && part number scsi 0 userdata partnum && ext4load scsi 0:${partnum} ${kernel_addr_r} /boot/Image && ext4load scsi 0:${partnum} ${fdt_addr_r} /boot/sm8550-xiaomi-sheng.dtb && setenv bootargs root=PARTLABEL=userdata rw rootwait console=ttyMSM0,115200n8 console=ttyGS0 console=tty0 fbcon=map:0 loglevel=4 sheng.b=424 log_buf_len=8M && booti ${kernel_addr_r} - ${fdt_addr_r}
#
# Per-generation menu entries, imported from a file NixOS regenerates
# alongside extlinux.conf.
#
# The generated file owns the whole menu, index 0 included, and
# overwrites both static entries below. `env import` only overwrites what
# the file defines, so if it never loads the static bootmenu_0 (boot) and
# bootmenu_1 (fastboot) survive: always a way to boot, always a way into
# fastboot.
#
# Imported rather than enumerated because hush cannot list a directory
# into variables and has no command substitution.
#
# Loaded to ${pxefile_addr_r}, which sysboot reuses later for the config
# file. The two uses are sequential. Inventing another address risks
# colliding with an lmb allocation, since board_late_init() assigns these
# from lmb.
loadgenmenu=scsi scan && part number scsi 0 userdata partnum && ext4load scsi 0:${partnum} ${pxefile_addr_r} /boot/sheng-bootmenu.env && env import -t ${pxefile_addr_r} ${filesize}
# FALLBACK ONLY. The generated file replaces this with an entry named
# after the generation that will boot. Kept generic because a title
# hardcoded here cannot know which generation it selects.
#
# Must exist: entry 0 is what the countdown and a held power key select,
# so without it a missing generated file leaves nothing bootable.
#
# Clearing pxe_label_override lets extlinux.conf's DEFAULT win. It must be
# cleared explicitly: the variable persists for the rest of this boot once
# a generated entry has been highlighted.
bootmenu_0=Boot NixOS=setenv pxe_label_override; run bootlinux
# Reboot into ABL's fastboot.
#
# Qualcomm does not use the Android BCB/misc handshake here: the bcb
# write succeeds and ABL boots straight past it. The mechanism is a magic
# cookie in IMEM, read after the reset. Address from the stock Android
# DTB, which is what ABL actually looks at:
#
#     qcom,msm-imem@146aa000 {
#             restart_reason@65c { reg = <0x65c 0x04>; };
#
# so 0x146aa000 + 0x65c = 0x146aa65c, and 0x77665500 is the
# boot-to-bootloader value. (Mainline's sm8550.dtsi describes a DIFFERENT
# imem at 0x14680000 -- do not use that one.)
#
# The one reset-shaped entry that is safe: it lands in fastboot, a
# terminal recoverable state, and ABL clears the cookie when it honours
# it. The "NEVER ADD A reset ENTRY" rule below still holds for plain
# resets.
#
# Not U-Boot's own fastboot: this build has no USB gadget stack.
bootmenu_1=Reboot to fastboot (bootloader)=run rebootfastboot
rebootfastboot=mw.l 0x146aa65c 0x77665500 && reset
# NEVER ADD A "reset" ENTRY. A stuck button selects it, the board reboots
# into the menu, and selects it again -- a loop only fastboot breaks.
#
# Finite on purpose: -1 waits forever, stranding the boot if the buttons
# fail to bind.
bootmenu_delay=5
#
# loadgenmenu's failure is ignored: with no sheng-bootmenu.env the &&
# chain short-circuits and the menu is entries 0 and 1, which is the
# correct degraded state.
bootcmd=run loadgenmenu; bootmenu 5

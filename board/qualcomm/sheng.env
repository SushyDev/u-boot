# THIS file sets the boot delay, not CONFIG_BOOTDELAY. The whole
# environment comes from here (CONFIG_ENV_IS_NOWHERE +
# CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE), so a bootdelay= line silently
# overrides the Kconfig value.
#
# 0, so bootcmd runs the menu immediately. This is NOT the menu's
# timeout -- bootmenu_delay is. bootdelay is main_loop()'s "hit any key
# to stop autoboot" countdown, which runs first, and a button press
# during it drops to the U-Boot prompt, which cannot be typed at with
# three buttons. The menu's own countdown is the interactive window and
# its appended "U-Boot console" entry is the deliberate way to the
# prompt.
bootdelay=0
bootretry=-1
# nulldev FIRST, then the buttons.
#
# NEVER use a bare "button-kbd". If it fails to probe the board has no
# stdin at all and will not boot -- recovery is fastboot. nulldev always
# binds and produces nothing, so it is a guaranteed-valid fallback, and
# CONSOLE_MUX polls every device in the list so the buttons still work.
#
# "serial" is deliberately absent: the debug UART is not connected and
# the floating RX reads as random characters, which selects a menu entry
# instantly.
stdin=nulldev,button-kbd
stdout=vidconsole
stderr=vidconsole

# Must be defined here -- this file is the entire environment, so
# nothing else sets them. All inside the 0x811d0000-0x88000000 bank and
# clear of every reserved-memory carveout in it.
kernel_addr_r=0x83000000
fdt_addr_r=0x86000000
pxefile_addr_r=0x87000000
scriptaddr=0x87000000
ramdisk_addr_r=0x87100000

# Manual scsi/ext4load/booti, bypassing bootflow/pxe, so bootargs are
# set explicitly here -- nothing parses extlinux.conf's APPEND line.
#
# console=tty0 + fbcon=map:0 is what puts the kernel boot log on the
# panel. fbcon alone does not make it a printk target; tty0 as a
# console= target is what does. Drop the pair and the log is
# serial-only.
#
# Bump sheng.b= on EVERY build. It is the only way to tell which image
# actually booted.
bootlinux=scsi scan && part number scsi 0 userdata partnum && ext4load scsi 0:${partnum} ${kernel_addr_r} /boot/Image && ext4load scsi 0:${partnum} ${fdt_addr_r} /boot/sm8550-xiaomi-sheng.dtb && setenv bootargs root=PARTLABEL=userdata rw rootwait console=ttyMSM0,115200n8 console=ttyGS0 console=tty0 fbcon=map:0 loglevel=4 sheng.b=417 log_buf_len=8M && booti ${kernel_addr_r} - ${fdt_addr_r}
# Entry 0 must stay the safe one: it is what the countdown selects, and what
# a held power key selects, since the highlight starts here.
bootmenu_0=Boot Linux (userdata)=run bootlinux
# Reboot into ABL's fastboot.
#
# Qualcomm does NOT use the Android BCB/misc handshake for this. Tried
# first (b372) and it does nothing: the bcb write succeeds, the board
# resets, and ABL boots normally straight past it.
#
# The real mechanism is a magic cookie in IMEM, which ABL reads after the
# reset. Address from the STOCK Android DTB (vendor_boot.img), which is
# authoritative for what ABL actually looks at:
#
#     qcom,msm-imem@146aa000 {
#             restart_reason@65c { reg = <0x65c 0x04>; };
#
# so 0x146aa000 + 0x65c = 0x146aa65c, and 0x77665500 is the
# boot-to-bootloader value. (Mainline's sm8550.dtsi describes a DIFFERENT
# imem at 0x14680000 -- do not use that one.)
#
# This is the one reset-shaped entry that is safe, and the "NEVER ADD A
# reset ENTRY" rule below still stands for plain resets. The difference
# is where it lands: a plain reset returns to this menu, so a stuck or
# bouncing button re-selects it forever and never reaches Linux. This
# lands in fastboot, which is a terminal, recoverable state -- and ABL
# clears the restart-reason cookie when it honours it, so the next boot
# is normal even if nobody touches anything.
#
# NOT U-Boot's own fastboot: this build has no USB gadget stack at all.
bootmenu_1=Reboot to fastboot (bootloader)=run rebootfastboot
rebootfastboot=mw.l 0x146aa65c 0x77665500 && reset
# NEVER ADD A "reset" ENTRY. A stuck or bouncing button selects it, the
# board reboots into the menu, and selects it again -- a loop that never
# reaches Linux and can only be broken over fastboot. Every other
# misfire is recoverable, because a power cycle returns to a menu that
# times out into entry 0.
#
# Finite on purpose: -1 waits forever, stranding the boot in an unusable
# menu if the buttons fail to bind. No Linux, no SSH, fastboot only.
bootmenu_delay=5
bootcmd=bootmenu 5

bootdelay=1
bootretry=-1
stdin=serial
stdout=serial
stderr=serial

# This file is the entire default environment (CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE),
# so kernel_addr_r/fdt_addr_r must be defined here for the kernel/FDT to load.
# They sit in the 0x811d0000-0x88000000 DRAM bank, verified against the live
# device's own /proc/device-tree/memory@a0000000/reg and clear of every
# reserved-memory carveout in that range.
kernel_addr_r=0x83000000
fdt_addr_r=0x86000000
pxefile_addr_r=0x87000000
scriptaddr=0x87000000
ramdisk_addr_r=0x87100000

# The manual scsi/ext4load/booti path below bypasses bootflow/pxe entirely,
# so extlinux.conf's APPEND line is never parsed -- bootargs must be set
# explicitly here or the kernel boots with no cmdline at all (root=PARTLABEL=...
# silently missing, "Unable to mount root fs on unknown-block(0,0)").
bootcmd=scsi scan && part number scsi 0 userdata partnum && ext4load scsi 0:${partnum} ${kernel_addr_r} /boot/Image && ext4load scsi 0:${partnum} ${fdt_addr_r} /boot/sm8550-xiaomi-sheng.dtb && setenv bootargs root=PARTLABEL=userdata rw rootwait console=ttyMSM0,115200n8 console=ttyGS0 fbcon=map:1 && booti ${kernel_addr_r} - ${fdt_addr_r}

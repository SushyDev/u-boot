# 30s window to interrupt autoboot and land at the U-Boot prompt.
#
# THIS is what actually sets the boot delay on this board, not
# CONFIG_BOOTDELAY. CONFIG_ENV_IS_NOWHERE=y + CONFIG_ENV_USE_DEFAULT_ENV_
# TEXT_FILE=y mean the whole environment comes from this file, so a
# bootdelay= line here overrides the Kconfig value silently. Setting
# CONFIG_BOOTDELAY=30 in sm8550_defconfig alone changed nothing -- the
# board still autobooted in 1 second.
# 5s: long enough to interrupt autoboot at the U-Boot prompt, short enough
# that a display test cycle isn't dominated by waiting. Was briefly 30 while
# chasing the serial console; that made every render test painfully slow.
#
# THIS is what sets the boot delay on this board, not CONFIG_BOOTDELAY.
# CONFIG_ENV_IS_NOWHERE=y + CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y mean the
# environment comes entirely from this file, so a bootdelay= line here
# silently overrides the Kconfig value.
bootdelay=5
bootretry=-1
stdin=serial
stdout=serial
stderr=serial

# This file is the entire default environment (CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE),
# so kernel_addr_r/fdt_addr_r must be defined here for the kernel/FDT to load.
# They sit in the 0x811d0000-0x88000000 DRAM bank, verified against the live
# device's own /proc/device-tree/memory@a0000000/reg and clear of every
# reserved-memory carveout in that range.
kernel_addr_r=0x83000000
fdt_addr_r=0x86000000
pxefile_addr_r=0x87000000
scriptaddr=0x87000000
ramdisk_addr_r=0x87100000

# Manual scsi/ext4load/booti path -- bypasses bootflow/pxe entirely (see
# ../../README or nixos/rootfs/builder.nix for why), so bootargs must be
# set explicitly here; nothing parses extlinux.conf's APPEND line.
#
# console=tty0 + fbcon=map:0 dropped (TEMPORARY, for the cont_splash
# investigation): that pair is what routes kernel printk/systemd
# boot-status text onto the framebuffer -- fbcon being active doesn't
# make it a printk target by itself, tty0 as a console= target is what
# does. With it gone, printk stays on the serial consoles only, and
# whatever ABL left in the `cont_splash` region (or simplefb's own
# scanout of it) isn't immediately scrolled over with boot-log text.
# Re-add `console=tty0 fbcon=map:0` once that's no longer needed --
# without it there's no on-screen boot log at all, serial-only.
bootcmd=scsi scan && part number scsi 0 userdata partnum && ext4load scsi 0:${partnum} ${kernel_addr_r} /boot/Image && ext4load scsi 0:${partnum} ${fdt_addr_r} /boot/sm8550-xiaomi-sheng.dtb && setenv bootargs root=PARTLABEL=userdata rw rootwait console=ttyMSM0,115200n8 console=ttyGS0 console=tty0 fbcon=map:0 loglevel=4 sheng.b=307 log_buf_len=8M sheng.panel=${sheng_mdss_panel} sheng.rd1=${sheng_mdss_rdsingle} sheng.pm=${sheng_mdss_power_mode} sheng.gdscp=${sheng_mdss_gdscp} sheng.lanact=${sheng_mdss_lanact} sheng.phystat=${sheng_mdss_phystatraw} sheng.fdel=${sheng_mdss_framedelta} sheng.abl=${sheng_mdss_ablgpio} sheng.blpost=${sheng_bl_post} && booti ${kernel_addr_r} - ${fdt_addr_r}

CONFIG_ARM=y
# Buffers early printf()/panic() output to xbl_ramdump_mem (a verified
# no-map reserved-memory region), readable via /dev/mem after a warm
# reset -- the only postmortem channel on this display/USB-less build.
CONFIG_PRE_CONSOLE_BUFFER=y
CONFIG_PRE_CON_BUF_SZ=16384
CONFIG_PRE_CON_BUF_ADDR=0x81200000
CONFIG_SKIP_LOWLEVEL_INIT=y
CONFIG_POSITION_INDEPENDENT=y
CONFIG_SYS_INIT_SP_BSS_OFFSET=0x180000
CONFIG_ARCH_SNAPDRAGON=y
CONFIG_NR_DRAM_BANKS=24
# Builds board/qualcomm/sheng/. Keeps the generic qcom config
# header, which SYS_CONFIG_NAME would otherwise derive from
# SYS_BOARD and look for as include/configs/sheng.h.
CONFIG_SYS_BOARD="sheng"
CONFIG_SYS_CONFIG_NAME="qcom"
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8550-xiaomi-sheng"
CONFIG_SYS_LOAD_ADDR=0xA0000000
CONFIG_FIT=y
CONFIG_FIT_VERBOSE=y
CONFIG_BOOTSTD_FULL=y
# CONFIG_BOOTMETH_VBE is not set
# A real window to interrupt and reach the prompt.
#
# Do NOT set -1. If the console is unreachable, -1 leaves a board that
# never boots Linux and therefore has no exec.sh either -- recoverable
# only by reflashing. 30 still autoboots if untouched.
CONFIG_BOOTDELAY=30

# md/mw to poke MDSS registers from the prompt, gpio to drive the panel
# reset and bias lines by hand. Both default to y; stated explicitly so
# an upstream default change cannot remove them silently.
CONFIG_CMD_MEMORY=y
CONFIG_CMD_GPIO=y
CONFIG_OF_BOARD_SETUP=y
CONFIG_SAVE_PREV_BL_INITRAMFS_START_ADDR=y
CONFIG_SYS_CBSIZE=512
CONFIG_LOG_MAX_LEVEL=9
CONFIG_LOG_DEFAULT_LEVEL=4
# CONFIG_DISPLAY_CPUINFO is not set
CONFIG_CMD_UFS=y
CONFIG_CMD_CAT=y
# CONFIG_OF_LIVE is not set
CONFIG_OF_UPSTREAM_BUILD_VENDOR=y
# DO NOT ENABLE CONFIG_OF_LIBFDT_OVERLAY here. Tried 2026-08-22 (b360) to
# get "dtc -@" and a __symbols__ node for ABL's cont_splash lookup. It
# did not stop ABL blanking, and it BROKE RENDERING: it adds a tenth
# lmb_alloc() in board_late_init() (fdtoverlay_addr_r) and grows the DTB
# by 35KB, which moves the LMB allocations onto the live framebuffer.
# That is the documented intermittent-corruption trap in this tree.

# Shell handoff: ABL -> U-Boot -> kernel on UFS, no interactive UX. See
# board/qualcomm/sheng.env for the boot sequence.
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/sheng.env"
CONFIG_PANIC_HANG=y
# CONFIG_SILENT_CONSOLE is not set
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set

CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
# CONFIG_WATCHDOG is not set
# CONFIG_HW_WATCHDOG is not set
# CONFIG_WDT is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_MMC is not set
# The display driver. See drivers/video/qualcomm/ARCHITECTURE.md.
CONFIG_VIDEO=y
CONFIG_VIDEO_SHENG_MDSS=y
# IMAGE SIZE IS A BUDGET, NOT A PREFERENCE. Crossing ~1MB of loaded
# size (kernel_offset 0x8000 + kernel_size) collides with something ABL
# still has resident, and _main's first instruction never executes.
# Keep the binary small; the splash logo and BMP decode buy nothing
# here.
#
# CONFIG_VIDEO_LOGO must stay off for a second reason: show_splash() is
# called from video_post_probe() and its failure return propagates out,
# aborting the console bind that follows. The logo is a BMP and BMP
# support is disabled below.
# CONFIG_VIDEO_LOGO is not set
# CONFIG_VIDEO_BMP_RLE8 is not set
# CONFIG_BMP is not set
# CONFIG_CMD_BMP is not set
# Both are required for the console to appear on the panel: without
# SYS_CONSOLE_IS_IN_ENV the env's stdout is never consulted, and without
# CONSOLE_MUX stdout can only be one device, so "serial,vidconsole"
# cannot take effect.
#
# These make console_init_r() look up stdin/stdout/stderr in the
# environment. If sheng.env stops defining all three, the board hangs
# silently before any console output at all.
CONFIG_CONSOLE_MUX=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
# The panel is 3048x2032, so an 8x16 bitmap font is ~1/380th of the screen
# width: the console renders correctly but is effectively invisible (7 lines
# read as "nothing on screen", 40 lines only showed up as faint glitching).
# CONSOLE_TRUETYPE would give a scalable font but cannot be built here --
# stb_truetype uses floating point and U-Boot's arm64 build is
# -mgeneral-regs-only. 16x32 is the largest bitmap font available, 4x the
# area of 8x16. Select it alone so it is the one actually used.
# CONFIG_VIDEO_FONT_8X16 is not set
CONFIG_VIDEO_FONT_16X32=y
# CONFIG_VIDEO_DAMAGE: REQUIRED here, not an optimisation.
#
# CONFIG_CYCLIC is off, so video_sync()'s rate limiter
# (`if (CONFIG_IS_ENABLED(CYCLIC) && !force && ...) return 0;`) never
# fires and EVERY putc runs a full sync. Without damage tracking
# video_flush_dcache() then flushes the entire framebuffer -- 24MB, i.e.
# ~390k cache-maintenance ops per character -- which is what made the
# boot menu's once-a-second countdown redraw unusable. With it on, only
# the rectangle that actually changed is flushed.
CONFIG_VIDEO_DAMAGE=y
# Dark console: WHITE text on a BLACK background.
#
# U-Boot's default is the other way round, which is why video_clear() painted
# the whole 3048x2032 panel white -- a full-brightness flash on every screen
# clear, and the boot menu rendered as a white sheet. It is also the wrong
# background for this driver: sheng_mdss_probe() fills the framebuffer solid
# black before handing it over, so black-on-white put black glyphs on black
# until video_clear() repainted, and any region the console had not touched
# stayed black anyway.
#
# White-on-black matches the driver's own fill, so the panel is uniformly
# dark from the very first frame through to the menu.
CONFIG_SYS_WHITE_ON_BLACK=y
# Interactive boot menu on the panel. The board has no reachable UART, so
# the only usable input is the physical buttons: BUTTON_KEYBOARD turns them
# into a keyboard, BUTTON_QCOM_PMIC covers the PMIC pwrkey/resin, and
# AUTOBOOT_MENU_SHOW replaces the plain countdown with the menu itself.
CONFIG_DM_KEYBOARD=y
CONFIG_BUTTON_KEYBOARD=y
CONFIG_BUTTON_QCOM_PMIC=y
CONFIG_CMD_BOOTMENU=y
# CONFIG_CMD_BCB is not set -- the Android BCB/misc handshake does NOT
# make this SoC boot to fastboot (measured, b372: the write succeeds and
# ABL ignores it). The "Reboot to fastboot" entry writes the IMEM
# restart-reason cookie with mw instead; see board/qualcomm/sheng.env.
# The boot menu clears the screen, positions the cursor and uses reverse
# video for the selected entry, so it needs ANSI. A non-ANSI vidconsole
# prints the escapes as raw control characters instead.
CONFIG_SYS_DEVICE_NULLDEV=y
CONFIG_VIDEO_ANSI=y
# Off: bootcmd drives the menu itself. CMD_BOOTMENU stays available so
# `bootmenu` can be run by hand.
# CONFIG_AUTOBOOT_MENU_SHOW is not set
# `version` is used by bootcmd to put real U-Boot build info on the panel.
# U-Boot's own banner is printed before the video device probes and is then
# wiped by video_clear(), so it never reaches the screen; re-emitting it from
# bootcmd is the way to actually see it. Without this the command does not
# exist, bootcmd fails at that point, and every && after it is skipped.
CONFIG_CMD_VERSION=y
# CONFIG_VIDEO implies these. The panel is driven entirely by
# sheng_mdss, and CYCLIC being off is what makes VIDEO_DAMAGE mandatory
# above.
# CONFIG_PANEL is not set
# CONFIG_SIMPLE_PANEL is not set
# CONFIG_CYCLIC is not set
# CONFIG_BACKLIGHT is not set
CONFIG_CLK=y
CONFIG_CLK_STUB=y
CONFIG_CLK_QCOM_SM8550=y
CONFIG_CLK_QCOM_APQ8016=y
CONFIG_CLK_QCOM_APQ8096=y
CONFIG_CLK_QCOM_MILOS=y
CONFIG_CLK_QCOM_QCM2290=y
CONFIG_CLK_QCOM_QCS404=y
CONFIG_CLK_QCOM_QCS615=y
CONFIG_CLK_QCOM_QCS8300=y
CONFIG_CLK_QCOM_SA8775P=y
CONFIG_CLK_QCOM_SDM845=y
CONFIG_CLK_QCOM_SM6115=y
CONFIG_CLK_QCOM_SM6125=y
CONFIG_CLK_QCOM_SM6350=y
CONFIG_CLK_QCOM_SM7150=y
CONFIG_CLK_QCOM_SM8150=y
CONFIG_CLK_QCOM_SM8250=y
CONFIG_CLK_QCOM_SM8550=y
CONFIG_CLK_QCOM_SM8650=y
CONFIG_CLK_QCOM_SC7280=y
CONFIG_CLK_QCOM_X1E80100=y
CONFIG_MSM_GPIO=y
CONFIG_QCOM_PMIC_GPIO=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM8650=y
CONFIG_IOMMU=y
CONFIG_QCOM_HYP_SMMU=y
CONFIG_MISC=y
CONFIG_NVMEM=y
CONFIG_QCOM_GENI=y
CONFIG_DM_I2C=y
CONFIG_SYS_I2C_GENI=y
CONFIG_PHY=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PINCTRL=y
CONFIG_PINCONF=y
CONFIG_PINCTRL_QCOM_GENERIC=y
CONFIG_QCOM_RPMH_POWER_DOMAIN=y
CONFIG_DM_PMIC=y
CONFIG_PMIC_QCOM=y
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_FIXED=y
CONFIG_DM_REGULATOR_QCOM_RPMH=y
# UFS is the only persistent storage path on SM8550 (no eMMC) and the
# route to /boot/extlinux/extlinux.conf on the flashed rootfs partition.
CONFIG_SCSI=y
CONFIG_MSM_SERIAL=y
CONFIG_MSM_GENI_SERIAL=y
CONFIG_SOC_QCOM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_SPMI_MSM=y
CONFIG_SYSRESET_QCOM_PSHOLD=y
# PSCI SYSTEM_RESET, and it must be available for "Reboot to fastboot" to
# work at all.
#
# MEASURED: writing the IMEM restart-reason cookie (0x146aa65c =
# 0x77665500) and resetting from LINUX lands in ABL's fastboot. The same
# cookie written from U-Boot did NOT -- the board just reboots normally.
# The cookie is not the problem; the reset path is. Linux resets via PSCI
# (sysrq-b -> psci_sys_reset), whereas qcom_pshold writes 0 to PS_HOLD,
# which does not preserve the reason across the reset.
#
# Both drivers stay enabled: sysreset_walk() tries each in turn, so
# PSHOLD remains the fallback if the PSCI call is ever unavailable.
CONFIG_SYSRESET_PSCI=y
CONFIG_UFS=y
CONFIG_UFS_QCOM=y
# arm64 "Image" header parsing, needed for booti to size/relocate the
# kernel correctly.
CONFIG_LINUX_KERNEL_IMAGE_HEADER=y

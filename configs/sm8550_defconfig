CONFIG_ARM=y
# Buffer any printf()/panic()/log_err() output to a fixed physical RAM
# address before a real console exists (gd->precon_buf_idx defaults to 0,
# not negative, so this is live as soon as gd itself is set up, early in
# board_init_f).
#
# Address is xbl_ramdump_mem's base (0x81200000, size 0x280000) -- a
# real, verified no-map reserved-memory region from the live device's own
# memory map, readable via /dev/mem from a subsequent `fastboot boot`
# into a known-working Linux image after a warm reset. Kept in this
# stripped-down "shell" build because it's the only postmortem channel
# left once the USB/display bring-up code is gone.
CONFIG_PRE_CONSOLE_BUFFER=y
CONFIG_PRE_CON_BUF_SZ=16384
CONFIG_PRE_CON_BUF_ADDR=0x81200000
CONFIG_SKIP_LOWLEVEL_INIT=y
CONFIG_POSITION_INDEPENDENT=y
CONFIG_SYS_INIT_SP_BSS_OFFSET=0x180000
CONFIG_ARCH_SNAPDRAGON=y
CONFIG_NR_DRAM_BANKS=24
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8550-xiaomi-sheng"
CONFIG_SYS_LOAD_ADDR=0xA0000000
CONFIG_FIT=y
CONFIG_FIT_VERBOSE=y
CONFIG_BOOTSTD_FULL=y
# CONFIG_BOOTMETH_VBE is not set
CONFIG_BOOTDELAY=1
CONFIG_OF_BOARD_SETUP=y
CONFIG_SAVE_PREV_BL_INITRAMFS_START_ADDR=y
CONFIG_SYS_CBSIZE=512
CONFIG_LOG_MAX_LEVEL=9
CONFIG_LOG_DEFAULT_LEVEL=4
# CONFIG_DISPLAY_CPUINFO is not set
CONFIG_CMD_UFS=y
CONFIG_CMD_CAT=y
# CONFIG_OF_LIVE is not set
CONFIG_OF_UPSTREAM_BUILD_VENDOR=y

# Shell handoff build: ABL -> U-Boot -> straight to the extlinux.conf
# kernel on UFS, no interactive UX at all. See board/qualcomm/sheng.env --
# bootcmd does `scsi scan; bootflow scan -lb` unconditionally, nothing
# more. All of the previous bring-up code (framebuffer/panel/backlight,
# USB gadget/fastboot, button-kbd/bootmenu, EFI bootmgr+NVRAM for
# systemd-boot) is intentionally gone; it's preserved on the
# xiaomi-sheng branch (git stash + prior commits) if it's needed again.
# This build exists purely to answer one question: does execution reach
# the final kernel-jump handoff in arch/arm/lib/bootm.c at all. See the
# psci_system_reset() trap there.
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/sheng.env"
CONFIG_PANIC_HANG=y
# CONFIG_SILENT_CONSOLE is not set
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set

CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
# CONFIG_WATCHDOG is not set

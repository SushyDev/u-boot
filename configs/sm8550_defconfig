# UFS is the only persistent storage path on SM8550 (no eMMC) and is the
# route to /boot/extlinux/extlinux.conf on the flashed rootfs partition,
# so it stays enabled even though upstream SM8550 UFS support is still
# young -- debug any instability directly rather than disabling it.
CONFIG_SCSI=y
CONFIG_MSM_SERIAL=y
CONFIG_MSM_GENI_SERIAL=y
CONFIG_SOC_QCOM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_SPMI_MSM=y
CONFIG_SYSRESET_QCOM_PSHOLD=y
CONFIG_UFS=y
CONFIG_UFS_QCOM=y
# Distro-boot arm64 "Image" header parsing (magic/text_offset/image_size)
# -- unrelated to display despite living near CONFIG_VIDEO upstream,
# needed for booti/extlinux to size and relocate the kernel correctly.
CONFIG_LINUX_KERNEL_IMAGE_HEADER=y

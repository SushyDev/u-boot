CONFIG_ARM=y
# Buffers early printf()/panic() output to xbl_ramdump_mem (a verified
# no-map reserved-memory region), readable via /dev/mem after a warm
# reset -- the only postmortem channel on this display/USB-less build.
CONFIG_PRE_CONSOLE_BUFFER=y
CONFIG_PRE_CON_BUF_SZ=16384
CONFIG_PRE_CON_BUF_ADDR=0x81200000
CONFIG_SKIP_LOWLEVEL_INIT=y
CONFIG_POSITION_INDEPENDENT=y
CONFIG_SYS_INIT_SP_BSS_OFFSET=0x180000
CONFIG_ARCH_SNAPDRAGON=y
CONFIG_NR_DRAM_BANKS=24
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8550-xiaomi-sheng"
CONFIG_SYS_LOAD_ADDR=0xA0000000
CONFIG_FIT=y
CONFIG_FIT_VERBOSE=y
CONFIG_BOOTSTD_FULL=y
# CONFIG_BOOTMETH_VBE is not set
CONFIG_BOOTDELAY=1
CONFIG_OF_BOARD_SETUP=y
CONFIG_SAVE_PREV_BL_INITRAMFS_START_ADDR=y
CONFIG_SYS_CBSIZE=512
CONFIG_LOG_MAX_LEVEL=9
CONFIG_LOG_DEFAULT_LEVEL=4
# CONFIG_DISPLAY_CPUINFO is not set
CONFIG_CMD_UFS=y
CONFIG_CMD_CAT=y
# CONFIG_OF_LIVE is not set
CONFIG_OF_UPSTREAM_BUILD_VENDOR=y

# Shell handoff: ABL -> U-Boot -> kernel on UFS, no interactive UX. See
# board/qualcomm/sheng.env for the boot sequence.
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/sheng.env"
CONFIG_PANIC_HANG=y
# CONFIG_SILENT_CONSOLE is not set
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set

CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
# CONFIG_WATCHDOG is not set
# CONFIG_HW_WATCHDOG is not set
# CONFIG_WDT is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_MMC is not set
# CONFIG_VIDEO / CONFIG_VIDEO_SHENG_MDSS: TEMPORARILY disabled (SPEC.md
# task #5 log) -- testing the theory that our own driver's hardware
# pokes (GDSC/DISPCC/DSI-PHY/DPU/RSC, all run before Linux boots) leave
# something (likely PMIC/LPG-adjacent) in a state Linux's own drm/msm
# can't fully recover from, even though DPU/DSI itself still binds and
# renders. Matches the hardware state at commit 2d6803cc (before
# sheng_mdss.c existed at all), which is confirmed to have worked with
# debian-sheng + backlight. Re-enable once this is confirmed/ruled out.
# CONFIG_VIDEO is not set
# CONFIG_VIDEO_SHENG_MDSS is not set
# Root cause of the CONFIG_VIDEO hang (see git history / SPEC.md):
# growing the u-boot binary enough to cross ~1MB loaded size (physical
# kernel_offset 0x8000 + kernel_size) apparently collides with
# something ABL still has resident there while jumping into "the
# kernel" (actually u-boot.bin) -- confirmed via breadcrumb
# instrumentation that _main's first instruction never even executes
# once that boundary is crossed. Not a bug in any of our code; a size
# budget. Trim what we don't need: the embedded splash logo and its
# BMP decode support save real space for zero functional loss (we
# don't use splash screens).
# CONFIG_VIDEO_LOGO is not set
# CONFIG_VIDEO_BMP_RLE8 is not set
# CONFIG_BMP is not set
# CONFIG_CMD_BMP is not set
# CONFIG_VIDEO pulls these in via `imply`, and CONSOLE_MUX +
# SYS_CONSOLE_IS_IN_ENV means console_init_r() looks up stdin/stdout/
# stderr device names from the saved environment -- this board's env
# was never set up with those and hung silently before any console
# output at all when this was left on (confirmed on hardware). Force
# both off; a single fixed serial console is all that's needed here.
# CONFIG_CONSOLE_MUX is not set
# CONFIG_SYS_CONSOLE_IS_IN_ENV is not set
# Still hung with just those two off -- force off the rest of what
# CONFIG_VIDEO implies too, to isolate whether it's one of these or
# something in the core video uclass itself.
# CONFIG_PANEL is not set
# CONFIG_SIMPLE_PANEL is not set
# CONFIG_CYCLIC is not set
# CONFIG_BACKLIGHT is not set

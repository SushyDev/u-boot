# qcom-phone.config fragment (board/qualcomm/qcom-phone.config): most
# phones/tablets lack a physical keyboard or accessible serial console, so
# this pulls in the bootmenu-driven UX, panic-on-hang so errors stay on
# screen, and CDC-ACM USB gadget serial for `tio`/fastboot-oem-log access.
#
# We use our own env (board/qualcomm/sheng.env, a copy of qcom-phone.env)
# instead of the stock one: during bring-up bootcmd must never attempt
# `bootefi bootmgr` unattended, and the USB serial gadget needs to be live
# from power-on rather than opt-in from a bootmenu we may not be able to see
# yet (the on-screen framebuffer address/resolution is still unverified).
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/sheng.env"
CONFIG_PANIC_HANG=y
# CONFIG_SILENT_CONSOLE is not set
CONFIG_CMD_PAUSE=y
CONFIG_BOOT_RETRY=y
CONFIG_BOOT_RETRY_TIME=1
CONFIG_BUTTON_REMAP_PHONE_KEYS=y
CONFIG_RETRY_BOOTCMD=y
CONFIG_FASTBOOT_BUF_ADDR=0x1A000000
CONFIG_USB_FUNCTION_ACM=y
CONFIG_CMD_UMS_ABORT_KEYED=y
CONFIG_CMD_FASTBOOT_ABORT_KEYED=y
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_INIT_F=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x6000
CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y
CONFIG_FASTBOOT_OEM_RUN=y
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set

# UEFI boot manager + NixOS/systemd-boot NVRAM support. EFI_VARIABLE_FILE_STORE
# stores boot variables as ubootefi.var on the ESP; EFI_RT_VOLATILE_STORE lets
# efibootmgr running under Linux update variables at runtime (held in RAM,
# must be flushed back to the file before reboot by a userspace service).
CONFIG_CMD_BOOTEFI_BOOTMGR=y
CONFIG_EFI_VARIABLE_FILE_STORE=y
CONFIG_FAT_WRITE=y
CONFIG_EFI_VAR_BUF_SIZE=32768
CONFIG_EFI_RT_VOLATILE_STORE=y
CONFIG_EFI_DEVICE_PATH_TO_TEXT=y
CONFIG_EFI_DEVICE_PATH_UTIL=y
CONFIG_EFI_UNICODE_COLLATION_PROTOCOL2=y
CONFIG_BOOTCOMMAND="bootefi bootmgr"

